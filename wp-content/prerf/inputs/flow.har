K\",\nF8.HTML5_SPS_UMP_STATUS_REJECTED=\"\\u0110\\u00e3 x\\u1ea3y ra l\\u1ed7i. H\\u00e3y l\\u00e0m m\\u1edbi ho\\u1eb7c th\\u1eed l\\u1ea1i sau. $BEGIN_LINKT\\u00ecm hi\\u1ec3u th\\u00eam$END_LINK\",F8.INVALID_DRM_MESSAGE=\"Th\\u00f4ng b\\u00e1o ri\\u00eang c\\u1ee7a h\\u1ec7 th\\u1ed1ng DRM kh\\u00f4ng h\\u1ee3p l\\u1ec7.\",F8.PURCHASE_NOT_FOUND=\"Video n\\u00e0y y\\u00eau c\\u1ea7u thanh to\\u00e1n.\",F8.PURCHASE_REFUNDED=\"Giao d\\u1ecbch mua video n\\u00e0y \\u0111\\u00e3 \\u0111\\u01b0\\u1ee3c ho\\u00e0n l\\u1ea1i ti\\u1ec1n.\",F8.RENTAL_EXPIRED=\n\"Th\\u1eddi gian thu\\u00ea video n\\u00e0y \\u0111\\u00e3 h\\u1ebft h\\u1ea1n.\",F8.CAST_SESSION_DEVICE_MISMATCHED=\"Thi\\u1ebft b\\u1ecb trong Phi\\u00ean truy\\u1ec1n kh\\u00f4ng kh\\u1edbp v\\u1edbi thi\\u1ebft b\\u1ecb \\u0111\\u01b0\\u1ee3c y\\u00eau c\\u1ea7u.\",F8.CAST_SESSION_VIDEO_MISMATCHED=\"Video trong Phi\\u00ean truy\\u1ec1n kh\\u00f4ng kh\\u1edbp v\\u1edbi video \\u0111\\u01b0\\u1ee3c y\\u00eau c\\u1ea7u.\",F8.CAST_TOKEN_FAILED=\"Phi\\u00ean truy\\u1ec1n kh\\u00f4ng kh\\u1ea3 d\\u1ee5ng. H\\u00e3y l\\u00e0m m\\u1edbi ho\\u1eb7c th\\u1eed l\\u1ea1i sau.\",\nF8.CAST_TOKEN_EXPIRED=\"Phi\\u00ean truy\\u1ec1n \\u0111\\u00e3 h\\u1ebft h\\u1ea1n. H\\u00e3y l\\u00e0m m\\u1edbi.\",F8.CAST_TOKEN_MALFORMED=\"Phi\\u00ean truy\\u1ec1n kh\\u00f4ng h\\u1ee3p l\\u1ec7. H\\u00e3y l\\u00e0m m\\u1edbi ho\\u1eb7c th\\u1eed l\\u1ea1i sau.\",F8.SERVER_ERROR=\"\\u0110\\u00e3 x\\u1ea3y ra l\\u1ed7i m\\u00e1y ch\\u1ee7 n\\u1ed9i b\\u1ed9. Vui l\\u00f2ng th\\u1eed l\\u1ea1i sau.\",F8.STOPPED_BY_ANOTHER_PLAYBACK=\"T\\u00e0i kho\\u1ea3n c\\u1ee7a b\\u1ea1n \\u0111ang ph\\u00e1t video n\\u00e0y \\u1edf m\\u1ed9t v\\u1ecb tr\\u00ed kh\\u00e1c. H\\u00e3y t\\u1ea3i l\\u1ea1i trang n\\u00e0y \\u0111\\u1ec3 ti\\u1ebfp t\\u1ee5c xem.\",\nF8.STREAM_LICENSE_NOT_FOUND=\"Ph\\u00e1t l\\u1ea1i video b\\u1ecb gi\\u00e1n \\u0111o\\u1ea1n. Vui l\\u00f2ng th\\u1eed l\\u1ea1i.\",F8.STREAMING_DEVICES_QUOTA_PER_24H_EXCEEDED=\"B\\u1ea1n \\u0111\\u0