          "content": {
            "size": 1595,
            "mimeType": "text/css",
            "text": "/**\n * Hide NASA/Elessi Breadcrumb - Static Blocks Dashboard\n * \n * This CSS provides immediate hiding before JavaScript removal\n */\n\n/* Hide breadcrumb with specific class combination */\nspan.nasa-flex.jc {\n    display: none !important;\n    visibility: hidden !important;\n    height: 0 !important;\n    overflow: hidden !important;\n}\n\n/* Fallback for browsers without :has() support */\nspan.nasa-flex.jc i.pe-7s-news-paper,\nspan.nasa-flex.jc i.pe7-icon.pe-7s-news-paper,\nspan.nasa-flex.jc i.fa-angle-right {\n    display: none !important;\n}\n\n/* Modern browsers with :has() support */\n@supports selector(:has(*)) {\n    /* More specific targeting if needed */\n    span.nasa-flex.jc:has(i.pe-7s-news-paper),\n    span.nasa-flex.jc:has(i.pe7-icon.pe-7s-news-paper) {\n        display: none !important;\n    }\n\n    /* Target breadcrumb containing specific text */\n    span.nasa-flex.jc:has(i.fa-angle-right) {\n        display: none !important;\n    }\n\n    /* Hide parent container if it only contains the breadcrumb */\n    .nasa-breadcrumb-wrap:has(> span.nasa-flex.jc:only-child),\n    .breadcrumb-wrap:has(> span.nasa-flex.jc:only-child) {\n        display: none !important;\n    }\n}\n\n/* Admin specific hiding */\nbody.wp-admin span.nasa-flex.jc,\nbody.admin-bar span.nasa-flex.jc {\n    display: none !important;\n}\n\n/* Frontend specific hiding */\nbody:not(.wp-admin) span.nasa-flex.jc {\n    display: none !important;\n}\n\n/* Hide with animation to prevent flash */\n@keyframes hideBreadcrumb {\n    from { opacity: 1; }\n    to { opacity: 0; }\n}\n\nspan.nasa-flex.jc {\n    animation: hideBreadcrumb 0.1s forwards;\n}"
          },
