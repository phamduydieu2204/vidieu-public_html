<?php
/**
 * Plugin Name: VCB-MH QR Code Fix
 * Description: Fix QR code không hiển thị trong VCB-MH
 * Version: 1.0
 */

if (!defined('ABSPATH')) {
    exit;
}

/**
 * Fix QR code display issue
 */
add_action('woocommerce_thankyou_vcb-gateway-mh', function($order_id) {
    ?>
    <script>
    jQuery(document).ready(function($) {
        // Debug
        console.log('VCB-MH QR Fix: Checking for missing QR images...');
        
        // Function to add QR image if missing
        function fixMissingQR() {
            // Get order info from hidden inputs
            var orderId = $('#vcb-gateway-order_id').val();
            var settings = $('#vcb-gateway-settings').data('settings');
            
            if (!orderId) {
                console.error('VCB-MH QR Fix: Order ID not found');
                return;
            }
            
            // Build QR URL based on VCB-MH logic
            var total = <?php 
                $order = wc_get_order($order_id);
                echo $order ? intval($order->get_total()) : '0';
            ?>;
            
            // Get VCB settings
            var vcbSettings = <?php
                $vcb_settings = get_option('vcb_gw_settings', []);
                echo json_encode([
                    'phone' => $vcb_settings['account']['phone'] ?? '0821000013390',
                    'name' => $vcb_settings['account']['name'] ?? 'PHAM DUY DIEU',
                    'prefix' => $vcb_settings['prefix'] ?? 'VIDIEUVN',
                    'suffix' => $vcb_settings['subfix'] ?? ''
                ]);
            ?>;
            
            var note = vcbSettings.prefix + orderId + vcbSettings.suffix;
            var qrUrl = 'https://api.vietqr.io/970436/' + vcbSettings.phone + '/' + total + '/' + note + '/qr_only.jpg';
            
            console.log('VCB-MH QR Fix: Generated QR URL:', qrUrl);
            
            // Check if QR images exist
            var $leftColQR = $('#left-col .qrVietqr');
            var $rightColQR = $('#right-col .qrVietqr');
            
            // Add QR to left column if missing
            if ($leftColQR.length === 0) {
                console.log('VCB-MH QR Fix: Adding QR to left column');
                var qrHtml = '<img class="qrVietqr" src="' + qrUrl + '" alt="QR Code chuyển khoản" />';
                $('#left-col .flex-center-box').after(qrHtml);
            } else if (!$leftColQR.attr('src')) {
                console.log('VCB-MH QR Fix: Setting QR src in left column');
                $leftColQR.attr('src', qrUrl);
            }
            
            // Add QR to right column PC section if missing
            if ($rightColQR.length === 0) {
                console.log('VCB-MH QR Fix: Adding QR to right column');
                var qrHtml = '<img class="qrVietqr" src="' + qrUrl + '" alt="QR Code chuyển khoản" />';
                $('.anPc > div:first-child').after(qrHtml);
            } else if (!$rightColQR.attr('src')) {
                console.log('VCB-MH QR Fix: Setting QR src in right column');
                $rightColQR.attr('src', qrUrl);
            }
            
            // Ensure all QR images are visible
            $('.qrVietqr').each(function() {
                $(this).css({
                    'display': 'block',
                    'visibility': 'visible',
                    'opacity': '1',
                    'max-width': '280px',
                    'margin': '20px auto'
                });
            });
            
            // Update download buttons to download QR
            $('.download-btn').off('click').on('click', function(e) {
                e.preventDefault();
                var link = document.createElement('a');
                link.href = qrUrl;
                link.download = 'QR-Vidieu-Order-' + orderId + '.jpg';
                link.click();
            });
        }
        
        // Run fix immediately
        fixMissingQR();
        
        // Run again after a short delay in case of async loading
        setTimeout(fixMissingQR, 500);
        
        // Also fix on any AJAX complete
        $(document).ajaxComplete(function() {
            setTimeout(fixMissingQR, 100);
        });
    });
    </script>
    
    <style>
    /* Ensure QR images are visible */
    #vcb-gateway .qrVietqr {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        max-width: 280px !important;
        height: auto !important;
        margin: 20px auto !important;
        border: 2px solid #ddd !important;
        padding: 10px !important;
        background: #fff !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1) !important;
    }
    
    /* Fix download button style */
    .download-btn {
        cursor: pointer !important;
        user-select: none !important;
    }
    
    .download-btn:hover {
        opacity: 0.8 !important;
    }
    </style>
    <?php
}, 15); // After VCB-MH's priority 4

/**
 * Alternative fix using filter
 */
add_filter('the_content', function($content) {
    if (!is_order_received_page()) {
        return $content;
    }
    
    // Check if VCB-MH content exists but QR missing
    if (strpos($content, 'id="vcb-gateway"') !== false && strpos($content, 'class="qrVietqr"') === false) {
        // Inject fix script
        $content .= '
        <script>
        // Emergency QR fix
        if (typeof jQuery !== "undefined") {
            jQuery(function($) {
                var checkCount = 0;
                var checkQR = setInterval(function() {
                    checkCount++;
                    if (checkCount > 10) {
                        clearInterval(checkQR);
                        return;
                    }
                    
                    var $vcbGateway = $("#vcb-gateway");
                    if ($vcbGateway.length && !$vcbGateway.find(".qrVietqr").length) {
                        console.warn("VCB-MH: QR still missing after " + checkCount + " checks");
                    }
                }, 1000);
            });
        }
        </script>';
    }
    
    return $content;
}, 999);

/**
 * Log QR generation for debugging
 */
add_action('init', function() {
    if (!is_order_received_page()) {
        return;
    }
    
    // Log VCB settings for debugging
    $vcb_settings = get_option('vcb_gw_settings');
    if ($vcb_settings && isset($vcb_settings['account']['phone'])) {
        error_log('VCB-MH Settings found: Phone = ' . $vcb_settings['account']['phone']);
    } else {
        error_log('VCB-MH Settings missing or incomplete!');
    }
});